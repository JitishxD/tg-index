# ---------- Telegram (https://my.telegram.org/apps) ----------
API_ID=123456
API_HASH=0123456789abcdef0123456789abcdef
# Comma-separated marked IDs (-100…) or usernames. Forum groups, channels, or a mix.
CHANNELS=-1001234567890,mychannel
# auto = channel > forum topic > first hashtag | topic | hashtag | chat
CATEGORY_MODE=auto

# ---------- Secrets ----------
# Generate EACH with: openssl rand -hex 32
# The server and web refuse to start with the placeholder values below.
API_SECRET=change-me
STREAM_SECRET=change-me-too
AUTH_SECRET=change-me-three
# Site login password (min 8 chars). Changing it logs everyone out.
SITE_PASSWORD=change-me-password

# ---------- Public hostname (Caddy gets a Let's Encrypt cert for it) ----------
DOMAIN=videos.example.com

# ---------- Optional tuning (defaults shown) ----------
MAX_STREAMS=8
STREAM_READ_AHEAD_MB=8
BACKFILL_DELAY_MS=500
RESYNC_MINUTES=30
