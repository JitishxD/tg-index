{
  "compilerOptions": {
    "target": "ES2022", "lib": [ "dom", "dom.iterable", "esnext" ], "strict": true, "noEmit": true,
    "module": "esnext", "moduleResolution": "bundler", "jsx": "preserve", "skipLibCheck": true,
    "isolatedModules": true, "esModuleInterop": true, "resolveJsonModule": true, "incremental": true,
    "plugins": [ { "name": "next" } ], "paths": { "@/*": [ "./src/*" ] }
  },
  "include": [ "next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts" ]
}
